# Copy this file to web/.env and replace the placeholders.
# web/.env is gitignored. Do not commit real values.
# These two are public in the browser once Row Level Security is enabled.
# Use the project URL and the anon or publishable key from Supabase, never the service-role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server only. Never prefix these with VITE_ and never put them in frontend code.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
